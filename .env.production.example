# Copy to .env.production on the VPS and replace every `replace-*` value before preflight.
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
API_DOCS_ENABLED=false
ALLOWED_HOSTS_CSV=monitor.example.com,api,localhost,127.0.0.1
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_ISSUER=cve-monitor-api
JWT_AUDIENCE=cve-monitor-web
JWT_ACCESS_TOKEN_MINUTES=30
SESSION_COOKIE_SECURE=true
PUBLIC_APP_URL=https://monitor.example.com
APP_ADDRESS=monitor.example.com

POSTGRES_DB=cve_monitor
POSTGRES_USER=cve_monitor
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql+psycopg://cve_monitor:replace-with-a-url-encoded-password@postgres:5432/cve_monitor
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://redis:6379/0
DEPENDENCY_TIMEOUT_SECONDS=2

OBJECT_STORAGE_ENABLED=false
STORAGE_ENDPOINT_URL=https://storage.internal.example.com
STORAGE_REGION=local
STORAGE_BUCKET=cve-monitor
STORAGE_ACCESS_KEY=replace-with-restricted-access-key
STORAGE_SECRET_KEY=replace-with-restricted-secret-key

AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
WEBHOOK_MAX_BODY_BYTES=1048576

PAYMENT_PROVIDER=razorpay
BILLING_PLANS_JSON={"starter_monthly":{"name":"Starter","description":"Vulnerability monitoring for a small business","amount_paise":49900,"currency":"INR","interval":"monthly","total_count":120}}
RAZORPAY_KEY_ID=replace-with-live-key-id
RAZORPAY_KEY_SECRET=replace-with-live-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-unique-webhook-secret
RAZORPAY_PLAN_IDS_JSON={"starter_monthly":"replace-with-live-plan-id"}

EMAIL_DELIVERY_ENABLED=true
EMAIL_FROM_ADDRESS=alerts@example.com
EMAIL_FROM_NAME=CVE Monitor
SMTP_HOST=smtp
SMTP_PORT=25
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15
NOTIFICATION_BATCH_LIMIT=500
NOTIFICATION_MAX_BATCHES_PER_RUN=20
DIGEST_HOUR_UTC=3
DIGEST_MINUTE_UTC=0
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
DKIM_SELECTOR=alerts

# Optional free NVD key. Leave blank for the lower anonymous request limit.
NVD_API_KEY=
NVD_RESULTS_PER_PAGE=2000
NVD_INITIAL_SYNC_START=2000-01-01T00:00:00Z
NVD_CPE_RESULTS_PER_PAGE=10000
NVD_CPE_INITIAL_SYNC_START=2000-01-01T00:00:00Z
MITRE_DELTA_LOG_URL=https://raw.githubusercontent.com/CVEProject/cvelistV5/main/cves/deltaLog.json
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_CSV_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz

BACKUP_RETENTION_DAYS=14
