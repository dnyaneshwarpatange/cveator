# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console
API_DOCS_ENABLED=true
ALLOWED_HOSTS_CSV=localhost,127.0.0.1,testserver,api
SESSION_COOKIE_SECURE=false

# Authentication — generate with: openssl rand -hex 32
# A unique, 32-byte-or-longer secret is mandatory outside development.
JWT_SECRET=replace-with-a-random-64-character-secret-before-production
JWT_ISSUER=cve-monitor-api
JWT_AUDIENCE=cve-monitor-web
JWT_ACCESS_TOKEN_MINUTES=30

# Billing. Internal plan IDs and product details are gateway-neutral.
PAYMENT_PROVIDER=razorpay
BILLING_PLANS_JSON={"starter_monthly":{"name":"Starter","description":"Vulnerability monitoring for a small business","amount_paise":49900,"currency":"INR","interval":"monthly","total_count":120}}

# Razorpay adapter. Use test-mode credentials until KYC and live-mode readiness are complete.
# Create each recurring Plan in Razorpay, then map the same internal plan ID here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_IDS_JSON={"starter_monthly":"plan_replace_with_your_test_plan"}

# PostgreSQL
POSTGRES_DB=cve_monitor
POSTGRES_USER=cve_monitor
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://cve_monitor:change-me@postgres:5432/cve_monitor
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# Redis / Celery
REDIS_URL=redis://redis:6379/0
DEPENDENCY_TIMEOUT_SECONDS=2
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
WEBHOOK_MAX_BODY_BYTES=1048576

# Optional S3-compatible object storage. Keep disabled until a maintained self-hosted
# endpoint, private bucket, and restricted application key are ready.
OBJECT_STORAGE_ENABLED=false
STORAGE_ENDPOINT_URL=
STORAGE_REGION=local
STORAGE_BUCKET=cve-monitor
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Transactional email. Disabled until the self-hosted SMTP and DNS steps are complete.
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM_ADDRESS=alerts@example.com
EMAIL_FROM_NAME=CVE Monitor
PUBLIC_APP_URL=http://localhost:3000
SMTP_HOST=smtp
SMTP_PORT=25
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15
NOTIFICATION_BATCH_LIMIT=500
NOTIFICATION_MAX_BATCHES_PER_RUN=20
# Daily digest time is UTC. 03:00 UTC is 08:30 India Standard Time.
DIGEST_HOUR_UTC=3
DIGEST_MINUTE_UTC=0

# Outbound-only Postfix/OpenDKIM container (`docker compose --profile mail up`).
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
DKIM_SELECTOR=alerts

# NVD. Leave empty to use the unauthenticated NVD rate limit.
NVD_API_KEY=
NVD_RESULTS_PER_PAGE=2000
NVD_INITIAL_SYNC_START=2000-01-01T00:00:00Z
NVD_CPE_RESULTS_PER_PAGE=10000
NVD_CPE_INITIAL_SYNC_START=2000-01-01T00:00:00Z

# Public upstreams. These are data sources, not SaaS dependencies.
MITRE_DELTA_LOG_URL=https://raw.githubusercontent.com/CVEProject/cvelistV5/main/cves/deltaLog.json
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_CSV_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
